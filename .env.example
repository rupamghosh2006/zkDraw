MIDNIGHT_PREPROD_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
MIDNIGHT_PREPROD_INDEXER_WS=wss://indexer.preprod.midnight.network/api/v4/graphql/ws
MIDNIGHT_PREPROD_NODE_URL=https://rpc.preprod.midnight.network
MIDNIGHT_PREPROD_NODE_WS=wss://rpc.preprod.midnight.network
MIDNIGHT_PREPROD_FAUCET_URL=https://midnight-tmnight-preprod.nethermind.dev/
