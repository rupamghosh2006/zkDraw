# ------------------------------------------------------------------------------
# 3. Fallback / Single-Network Generic Variables
# If you are configuring a single active network in your hosting dashboard:
# ------------------------------------------------------------------------------
# For Preview:
MIDNIGHT_CONTRACT_ADDRESS=f1667982258963752afb12360b34cbd7efcd11fa70930644c3cbf7bb8fb173ba
MIDNIGHT_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql
MIDNIGHT_NODE_URL=https://rpc.preview.midnight.network

# For Preprod (switch MIDNIGHT_NETWORK to 'preprod' and use):
# MIDNIGHT_CONTRACT_ADDRESS=f735bb890f2f309372b2dfa37a22515003bf521a243648c3eff2b36721de8959
# MIDNIGHT_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
# MIDNIGHT_NODE_URL=https://rpc.preprod.midnight.network

# ------------------------------------------------------------------------------
# 4. Zero-Knowledge Proving & Contracts Path (Local / Self-Hosted)
# ------------------------------------------------------------------------------
MIDNIGHT_PROOF_SERVER=http://127.0.0.1:6300

# ------------------------------------------------------------------------------
# 5. Pinata IPFS Decentralized Storage Configuration
# ------------------------------------------------------------------------------
# Recommended: Pinata JWT for pinning and querying registry data on IPFS
PINATA_JWT=your_pinata_jwt_token_here

# Alternatively, legacy Pinata API Key & Secret pair:
# PINATA_API_KEY=your_pinata_api_key_here
# PINATA_API_SECRET=your_pinata_api_secret_here

# Dedicated or Public IPFS Gateway (default: gateway.pinata.cloud):
PINATA_GATEWAY=gateway.pinata.cloud

