# ------------------------------------------------------------------------------
# 5. Pinata IPFS Decentralized Storage Configuration
# ------------------------------------------------------------------------------
# Recommended: Pinata JWT for pinning and querying registry data on IPFS
PINATA_JWT=your_pinata_jwt_token_here

# Alternatively, legacy Pinata API Key & Secret pair:
# PINATA_API_KEY=your_pinata_api_key_here
# PINATA_API_SECRET=your_pinata_api_secret_here

# Dedicated or Public IPFS Gateway (default: gateway.pinata.cloud):
PINATA_GATEWAY=gateway.pinata.cloud


# ==============================================================================
# 6. Escrow Treasury Service Configuration
# ==============================================================================
# The Escrow Treasury Service holds all ticket fees (tNIGHT) in a dedicated
# vault wallet and automatically pays out the jackpot to verified ZK winners.
#
# STEP 1 — Generate a new Midnight wallet using the 1AM Wallet browser extension.
#           Obtain its 24-word mnemonic and its bech32m address (mn_addr_...).
#           Fund it with enough tNIGHT from the testnet faucet.
#
# STEP 2 — Set the variables below. The address is shown in the UI to players
#           so they can verify their ticket payment destination.
#           The mnemonic is kept server-side only (never sent to the frontend).
#
# Without these set, the backend runs in SIMULATION MODE:
#   - Pot balance is tracked correctly
#   - Nullifiers are verified on-chain
#   - Payout is logged but NO REAL TRANSFER is made (simulated tx hash returned)

# --- Preprod Escrow Vault ---
ESCROW_PREPROD_ADDRESS=mn_addr_preprod1...
ESCROW_PREPROD_MNEMONIC=word1 word2 word3 ... word24

# --- Preview Escrow Vault ---
ESCROW_PREVIEW_ADDRESS=mn_addr_preview1...
ESCROW_PREVIEW_MNEMONIC=word1 word2 word3 ... word24

# --- Claim Settlement Window ---
# Time (ms) winners have to submit claims before the pot is split/settled.
# Default: 300000 (5 minutes). Increase for longer windows.
ESCROW_CLAIM_WINDOW_MS=300000

# --- Frontend (optional — auto-fetched from backend at runtime) ---
# VITE_ESCROW_PREPROD_ADDRESS=mn_addr_preprod1...
# VITE_ESCROW_PREVIEW_ADDRESS=mn_addr_preview1...
