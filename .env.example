# ==============================================================================
# zkDraw Root Environment Configuration
# ==============================================================================
# Copy this file to .env in the project root or set these variables
# in your cloud deployment platform (Render, Railway, Vercel, etc.)

# ------------------------------------------------------------------------------
# Core Server & Runtime Settings
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=production
CORS_ORIGIN=*

# Default Active Network ('preview' or 'preprod')
MIDNIGHT_NETWORK=preview

# ------------------------------------------------------------------------------
# 1. Midnight Preview Testnet Configuration
# ------------------------------------------------------------------------------
# Latest Deployed Contract (September 2026 - Block #742760):
MIDNIGHT_PREVIEW_CONTRACT_ADDRESS=f1667982258963752afb12360b34cbd7efcd11fa70930644c3cbf7bb8fb173ba

# Previous Month Contract (August 2026 - for reference):
# MIDNIGHT_PREVIEW_CONTRACT_ADDRESS_AUG=818d55c59ca40c32cb4e4585be9b13c116db0262edaffcc2b8c418867f96361b

MIDNIGHT_PREVIEW_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql
MIDNIGHT_PREVIEW_INDEXER_WS=wss://indexer.preview.midnight.network/api/v4/graphql/ws
MIDNIGHT_PREVIEW_NODE_URL=https://rpc.preview.midnight.network
MIDNIGHT_PREVIEW_NODE_WS=wss://rpc.preview.midnight.network
MIDNIGHT_PREVIEW_FAUCET_URL=https://midnight-tmnight-preview.nethermind.dev/
MIDNIGHT_PREVIEW_ADMIN_KEY=495e53af5d3db0c94bde14ceb65a8e036224eb4a086a1c4e9fa2fe5e0ecbbedf

# ------------------------------------------------------------------------------
# 2. Midnight Preprod Testnet Configuration
# ------------------------------------------------------------------------------
